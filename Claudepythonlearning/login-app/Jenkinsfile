pipeline {
    agent any

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                bat 'docker build -t login-app:latest ./Claudepythonlearning/login-app'
            }
        }

        stage('Load Image to Minikube') {
            steps {
                bat 'minikube image load login-app:latest'
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                bat 'kubectl apply -f ./Claudepythonlearning/login-app/deployment.yaml'
                bat 'kubectl apply -f ./Claudepythonlearning/login-app/service.yaml'
                bat 'kubectl rollout restart deployment/login-app'
                bat 'kubectl rollout status deployment/login-app --timeout=120s'
            }
        }
    }
}